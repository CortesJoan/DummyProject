/* Same enamel palette; scrollable route reserves space for the fixed start action. */
.postgame-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 24px; align-items: center; justify-content: center; background-color: rgba(4,12,27,.95); display: none; }
.postgame-panel { width: 980px; max-width: 96%; height: 92%; max-height: 900px; min-height: 0; padding: 24px; border-radius: 28px; border-width: 2px; border-color: rgb(132,185,202); background-color: rgb(17,38,64); }
.postgame-heading { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.postgame-title { font-size: 30px; color: rgb(250,241,219); -unity-font-style: bold; white-space: normal; flex-shrink: 1; margin-right: 16px; }
.postgame-progress { color: rgb(161,235,215); font-size: 18px; margin-top: 12px; margin-bottom: 12px; flex-shrink: 0; }
.postgame-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.postgame-node { flex-direction: row; align-items: center; margin: 4px 8px 8px 0; padding: 10px 18px; min-height: 94px; border-radius: 24px; border-width: 1px; border-color: rgb(98,146,172); background-color: rgb(25,54,82); }
.postgame-node.selected { background-color: rgb(34,91,116); border-width: 2px; border-color: rgb(247,209,142); }
.postgame-node:disabled { opacity: .48; }
.postgame-portrait { width: 68px; height: 68px; flex-shrink: 0; border-radius: 34px; overflow: hidden; background-color: rgb(17,38,64); border-width: 1px; border-color: rgb(132,185,202); align-items: center; justify-content: center; }
.postgame-portrait Label { color: rgb(255,237,194); font-size: 20px; -unity-font-style: bold; }
.postgame-node-copy { flex-grow: 1; flex-shrink: 1; margin-left: 18px; }
.postgame-node-title { color: rgb(250,241,219); font-size: 23px; white-space: normal; -unity-font-style: bold; }
.postgame-node-status { color: rgb(182,211,224); font-size: 14px; white-space: normal; margin-top: 6px; }
.postgame-node.cleared .postgame-node-status { color: rgb(161,235,215); }
.postgame-detail { color: rgb(223,232,240); font-size: 18px; white-space: normal; margin-top: 14px; margin-bottom: 12px; flex-shrink: 0; }
.postgame-action, .postgame-entry { height: 52px; flex-shrink: 0; padding-left: 22px; padding-right: 22px; border-radius: 26px; border-width: 1px; border-color: rgb(245,210,146); background-color: rgb(34,91,116); color: rgb(255,242,208); font-size: 18px; -unity-font-style: bold; }
.postgame-entry { display: none; margin-top: 12px; }
.postgame-action:disabled { opacity: .48; }
.postgame-overlay.portrait { padding: 12px; }
.postgame-overlay.portrait .postgame-panel { width: 100%; max-width: 100%; padding: 16px; height: 96%; }
.postgame-overlay.portrait .postgame-title { font-size: 24px; }
.postgame-overlay.portrait .postgame-node-title { font-size: 20px; }
.postgame-overlay.portrait .postgame-portrait { width: 58px; height: 58px; border-radius: 29px; }
.postgame-overlay.portrait .postgame-node { padding: 10px; }
